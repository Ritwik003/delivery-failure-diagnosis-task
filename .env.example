# Copy this file to .env and fill in the key. Keep .env out of version control.
#
#     cp .env.example .env

# Used by the OpenCode agent through the `minimax` provider.
MINIMAX_API_KEY=

# Fallback route. OpenCode's OpenAI-compatible provider pointed at MiniMax.
# Use these with `-m openai/MiniMax-M2.7` if the `minimax/` provider fails to
# authenticate. The ${...} form is resolved when the file is loaded, so only
# the key above needs filling in.
OPENAI_API_KEY=${MINIMAX_API_KEY}
OPENAI_BASE_URL=https://api.minimax.io/v1
